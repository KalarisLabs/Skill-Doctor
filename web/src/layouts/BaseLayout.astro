---
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Skill Doctor: Security and Diagnostics Platform for AI Agent Skills" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Skill Doctor</title>
    
    <!-- Open Graph -->
    <meta property="og:title" content={`${title} · Skill Doctor`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    
    <!-- Professional Typography: Inter + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans">
    <!-- Main Console Navigation Bar -->
    <header class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur">
      <div class="container flex h-14 max-w-screen-2xl items-center justify-between mx-auto px-4 sm:px-6">
        <div class="flex items-center space-x-6">
          <a href="/" class="flex items-center space-x-2.5 text-foreground hover:text-primary transition-colors">
            <div class="w-7 h-7 rounded bg-primary/15 border border-primary/30 flex items-center justify-center text-primary font-bold text-xs">
              SD
            </div>
            <span class="font-bold text-sm tracking-tight">
              Skill Doctor
            </span>
          </a>

          <nav class="hidden md:flex items-center space-x-1 text-xs font-medium">
            <a 
              href="/scan" 
              class={`px-3 py-1.5 rounded transition-colors ${currentPath === '/scan' || currentPath === '/' ? 'bg-secondary text-foreground font-semibold' : 'text-slate-400 hover:text-foreground hover:bg-secondary/60'}`}
            >
              Diagnostic Studio
            </a>
            <a 
              href="/scans" 
              class={`px-3 py-1.5 rounded transition-colors ${currentPath === '/scans' ? 'bg-secondary text-foreground font-semibold' : 'text-slate-400 hover:text-foreground hover:bg-secondary/60'}`}
            >
              Audit Log
            </a>
            <a 
              href="/threats" 
              class={`px-3 py-1.5 rounded transition-colors ${currentPath.startsWith('/threats') ? 'bg-secondary text-foreground font-semibold' : 'text-slate-400 hover:text-foreground hover:bg-secondary/60'}`}
            >
              ThreatDB
            </a>
            <a 
              href="/benchmarks" 
              class={`px-3 py-1.5 rounded transition-colors ${currentPath === '/benchmarks' ? 'bg-secondary text-foreground font-semibold' : 'text-slate-400 hover:text-foreground hover:bg-secondary/60'}`}
            >
              Benchmarks
            </a>
            <a 
              href="/docs" 
              class={`px-3 py-1.5 rounded transition-colors ${currentPath === '/docs' ? 'bg-secondary text-foreground font-semibold' : 'text-slate-400 hover:text-foreground hover:bg-secondary/60'}`}
            >
              Documentation
            </a>
            <a 
              href="/settings" 
              class={`px-3 py-1.5 rounded transition-colors ${currentPath === '/settings' ? 'bg-secondary text-foreground font-semibold' : 'text-slate-400 hover:text-foreground hover:bg-secondary/60'}`}
            >
              Settings
            </a>
          </nav>
        </div>

        <div class="flex items-center space-x-3">
          <!-- Operational Status Pill -->
          <div class="flex items-center gap-1.5 px-2.5 py-1 rounded bg-secondary text-slate-300 text-xs font-mono border border-border">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span class="text-[11px]">Cloudflare Edge</span>
          </div>

          <a 
            href="https://github.com/KalarisLabs/Skill-Doctor" 
            target="_blank" 
            rel="noreferrer" 
            class="p-1.5 rounded text-slate-400 hover:text-foreground hover:bg-secondary transition-colors"
            title="GitHub Repository"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
              <path d="M9 18c-4.51 2-5-2-7-2"/>
            </svg>
          </a>
        </div>
      </div>
    </header>
    
    <!-- Main Content Area -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Operational Footer -->
    <footer class="border-t border-border py-8 mt-16 bg-background">
      <div class="container flex flex-col sm:flex-row items-center justify-between gap-4 mx-auto px-4 sm:px-6 text-xs text-slate-400">
        <div>
          <span class="font-semibold text-foreground">Skill Doctor</span>
          <span> — Enterprise AI Agent Security Platform by </span>
          <a href="https://kalarislabs.com" target="_blank" rel="noreferrer" class="text-slate-300 hover:text-foreground underline underline-offset-2">Kalaris Labs</a>
        </div>

        <div class="flex items-center space-x-4 font-mono text-[11px]">
          <span>D1 + KV Ephemeral</span>
          <span>•</span>
          <span>YARA-X AST</span>
          <span>•</span>
          <span>SDTM-v1 Matrix</span>
        </div>
      </div>
    </footer>
  </body>
</html>
