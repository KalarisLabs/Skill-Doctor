---
import BaseLayout from '../layouts/BaseLayout.astro';

const benchmarkCategories = [
  { id: 'SD-01', name: 'System Prompt Override', samples: 32, precision: '99.2%', recall: '98.5%', f1: '0.988' },
  { id: 'SD-02', name: 'OS Command Injection', samples: 45, precision: '100.0%', recall: '99.4%', f1: '0.997' },
  { id: 'SD-03', name: 'Data Exfiltration & C2', samples: 28, precision: '97.8%', recall: '96.2%', f1: '0.970' },
  { id: 'SD-04', name: 'Privilege Escalation', samples: 24, precision: '99.0%', recall: '97.5%', f1: '0.982' },
  { id: 'SD-05', name: 'Supply Chain Tampering', samples: 19, precision: '98.4%', recall: '95.0%', f1: '0.967' },
  { id: 'SD-06', name: 'Server-Side Request Forgery', samples: 26, precision: '99.5%', recall: '99.0%', f1: '0.992' },
  { id: 'SD-07', name: 'Tool Poisoning', samples: 22, precision: '96.5%', recall: '94.8%', f1: '0.956' },
  { id: 'SD-08', name: 'Persistent Backdoors', samples: 20, precision: '98.9%', recall: '97.0%', f1: '0.979' },
  { id: 'SD-09', name: 'Context Flooding', samples: 18, precision: '100.0%', recall: '100.0%', f1: '1.000' },
  { id: 'SD-10', name: 'Unicode Obfuscation', samples: 25, precision: '99.1%', recall: '98.0%', f1: '0.985' },
];
---

<BaseLayout title="Security Benchmarks (SD-B-001 / SD-B-002)">
  <div class="container mx-auto px-4 sm:px-6 py-8 max-w-6xl space-y-8">
    <!-- Header -->
    <div class="border-b border-border pb-6">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
        Agent Security Benchmarks
      </h1>
      <p class="text-xs sm:text-sm text-slate-400 mt-1.5 max-w-3xl leading-relaxed">
        Empirical evaluation datasets (SD-B-001 / SD-B-002) measuring true positive detection rates and false positive suppression across the SDTM-v1 threat matrix.
      </p>
    </div>

    <!-- Core Datasets Overview -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="console-panel p-5 space-y-3">
        <div class="flex items-center justify-between font-mono text-xs">
          <span class="font-bold text-primary">DATASET SD-B-001</span>
          <span class="text-emerald-400 font-bold">98.9% F1 SCORE</span>
        </div>
        <h2 class="text-sm font-bold text-foreground">Static & Threat Intelligence Core Set</h2>
        <p class="text-xs text-slate-400 leading-relaxed">
          250 curated malicious skill bundles + 50 benign baseline controls evaluating deterministic AST sinks, shell execution, and known CVE signatures.
        </p>
        <div class="grid grid-cols-3 gap-2 pt-2 border-t border-border text-center font-mono text-xs">
          <div class="p-2 rounded bg-background">
            <div class="text-[10px] text-slate-500">Precision</div>
            <div class="font-bold text-foreground mt-0.5">99.1%</div>
          </div>
          <div class="p-2 rounded bg-background">
            <div class="text-[10px] text-slate-500">Recall</div>
            <div class="font-bold text-foreground mt-0.5">98.2%</div>
          </div>
          <div class="p-2 rounded bg-background">
            <div class="text-[10px] text-slate-500">Edge Latency</div>
            <div class="font-bold text-emerald-400 mt-0.5">&lt; 15ms</div>
          </div>
        </div>
      </div>

      <div class="console-panel p-5 space-y-3">
        <div class="flex items-center justify-between font-mono text-xs">
          <span class="font-bold text-primary">DATASET SD-B-002</span>
          <span class="text-emerald-400 font-bold">97.4% F1 SCORE</span>
        </div>
        <h2 class="text-sm font-bold text-foreground">Semantic Prompt Injection & Intent Set</h2>
        <p class="text-xs text-slate-400 leading-relaxed">
          100+ indirect prompt injection scenarios, context window flooders, and multi-turn jailbreaks evaluating Layer 2 Semantic Inference engines.
        </p>
        <div class="grid grid-cols-3 gap-2 pt-2 border-t border-border text-center font-mono text-xs">
          <div class="p-2 rounded bg-background">
            <div class="text-[10px] text-slate-500">Precision</div>
            <div class="font-bold text-foreground mt-0.5">97.8%</div>
          </div>
          <div class="p-2 rounded bg-background">
            <div class="text-[10px] text-slate-500">Recall</div>
            <div class="font-bold text-foreground mt-0.5">96.5%</div>
          </div>
          <div class="p-2 rounded bg-background">
            <div class="text-[10px] text-slate-500">Inference Latency</div>
            <div class="font-bold text-primary mt-0.5">~120ms</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Category Performance Table -->
    <div class="space-y-3">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-300">
        Matrix Performance by Category (SD-01 to SD-10)
      </h2>

      <div class="console-panel overflow-hidden">
        <table class="w-full text-left text-xs">
          <thead class="bg-secondary border-b border-border text-slate-400 font-mono">
            <tr>
              <th class="p-3 pl-4 font-semibold">ID</th>
              <th class="p-3 font-semibold">Threat Class</th>
              <th class="p-3 font-semibold text-center">Corpus Count</th>
              <th class="p-3 font-semibold text-center">Precision</th>
              <th class="p-3 font-semibold text-center">Recall</th>
              <th class="p-3 pr-4 font-semibold text-right">F1 Metric</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border font-mono">
            {benchmarkCategories.map((c) => (
              <tr key={c.id} class="hover:bg-secondary/40 transition-colors">
                <td class="p-3 pl-4 font-bold text-primary">{c.id}</td>
                <td class="p-3 font-sans font-medium text-foreground">{c.name}</td>
                <td class="p-3 text-center text-slate-400">{c.samples}</td>
                <td class="p-3 text-center text-emerald-400 font-semibold">{c.precision}</td>
                <td class="p-3 text-center text-emerald-400 font-semibold">{c.recall}</td>
                <td class="p-3 pr-4 text-right font-bold text-foreground">{c.f1}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</BaseLayout>
