---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ScannerApp } from '../components/scanner/ScannerApp';
---

<BaseLayout title="Security Diagnostics Studio">
  <div class="container mx-auto px-4 sm:px-6 py-8 max-w-6xl">
    <!-- Studio Header -->
    <div class="mb-8 border-b border-border pb-6">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
        Agent Skill Security Diagnostics
      </h1>
      <p class="text-sm text-slate-400 mt-1.5 max-w-3xl leading-relaxed">
        Static AST validation, adversarial prompt injection detection, behavioral sandbox egress traces, and ThreatDB CVE correlation for AI agent tools.
      </p>
    </div>
    
    <!-- Interactive Diagnostic Studio Island -->
    <ScannerApp client:load />
  </div>
</BaseLayout>
