---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ReportView } from '../../components/report/ReportView';

const { scanId } = Astro.params;

if (!scanId) {
  return Astro.redirect('/');
}
---

<BaseLayout title={`Report ${scanId.substring(0,8)}`}>
  <div className="container mx-auto px-4 py-8 max-w-5xl">
    <div className="mb-8">
      <a href="/" className="text-sm text-muted-foreground hover:text-foreground transition-colors">
        ← Back to Scanner
      </a>
      <h1 className="text-3xl font-bold mt-4 font-mono">Scan Report</h1>
      <p className="text-muted-foreground mt-1">ID: {scanId}</p>
    </div>
    
    <ReportView client:load scanId={scanId} />
  </div>
</BaseLayout>
